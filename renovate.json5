{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":semanticCommits",
    "github>mikutas/my-renovate-config"
  ],
  "customManagers": [
    {
      // rollout-extension
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-.]+?)(?: depName=(?<depName>.+?))(?: packageName=(?<packageName>.+?))?(?: registryUrl=(?<registryUrl>.+?))?\\s.*(?<currentValue>\\d+\\.\\d+\\.\\d+(?:[a-z-]+)?).*"
      ]
    },
    {
      // k3d
      "customType": "regex",
      "managerFilePatterns": [
        "/k3d-default\\.ya?ml/"
      ],
      "matchStrings": [
        "image:\\s*(?<depName>[^:]+):(?<currentValue>v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:-(?<prerelease>[a-z]+\\d+))?(?<compatibility>\\-k3s)(?<build>\\d+))"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "docker.io/rancher/k3s"
    },
    {
      // kind
      "customType": "regex",
      "managerFilePatterns": [
        "/kind.*\\.ya?ml/"
      ],
      "matchStrings": [
        "image:\\s*(?<depName>[^:]+):(?<currentValue>v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+))"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "kindest/node"
    },
    {
      // https://docs.renovatebot.com/modules/datasource/git-refs/
      // policies/配下でraw.githubusercontent.comから取り込むkyverno/policiesのポリシーを、
      // mainブランチの最新コミットハッシュに追従させる
      "customType": "regex",
      "managerFilePatterns": [
        "/^policies/.+/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/kyverno/policies/(?<currentDigest>[0-9a-f]{40})/"
      ],
      "depNameTemplate": "kyverno/policies",
      "packageNameTemplate": "https://github.com/kyverno/policies",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      // 全kustomization.yamlの参照を1つのPRで更新する
      "groupName": "kyverno-policies",
      "matchDepNames": ["kyverno/policies"]
    },
    {
      "matchDepNames": ["linkerd/linkerd2"],
      // https://docs.renovatebot.com/modules/versioning/
      "versioning": "regex:(?<compatibility>stable|edge)-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)?"
    },
    {
      "matchPackageNames": [
        "/linkerd2/", // CLI
        "/linkerd-crds/",
        "/linkerd-control-plane/",
        "/linkerd-viz/"
      ],
      "groupName": "linkerd",
      "addLabels": [
        "linkerd"
      ]
    },
    {
      "matchPackageNames": [
        "/argo-workflows/",
        "/goldilocks/",
        "/odigos/"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": [
        "/postgresql/"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "matchDepNames": [
        "podinfo"
      ],
      "groupName": "podinfo"
    },
    {
      "matchPackageNames": [
        "ghcr.io/stefanprodan/podinfo"
      ],
      "groupName": "podinfo"
    }
  ]
}
